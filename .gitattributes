# gradlew is a POSIX shell script: Git's autocrlf would rewrite it to CRLF and
# break it on Linux/macOS ("bad interpreter: No such file or directory").
gradlew text eol=lf
gradlew.bat text eol=crlf

# Gradle wrapper jar is binary and must not be touched.
*.jar binary

*.json text eol=lf
*.toml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

*.java text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
